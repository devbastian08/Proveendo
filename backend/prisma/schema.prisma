// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     Int            @id @default(autoincrement())
  nombre                 String
  correo                 String         @unique
  contrasena             String
  rol                    String         // Ej: "distribuidor", "admin", "asesor"
  puedeAlistar           Boolean        @default(false)
  
  // Relación si el usuario es DUEÑO
  distribuidora          Distribuidora? @relation("DistribuidoraOwner")
  
  // Relación si el usuario TRABAJA para la distribuidora
  distribuidoraTrabajoId Int?
  distribuidoraTrabajo   Distribuidora? @relation("DistribuidoraEmpleados", fields: [distribuidoraTrabajoId], references: [id])
  
  tendero                Tendero?
  entregas               Entrega[]
}

model Distribuidora {
  id          Int        @id @default(autoincrement())
  nombre      String
  slug        String     @unique // Para la URL amigable: /tienda/mi-distribuidora
  descripcion String?
  logoUrl     String?
  portadaUrl  String?
  telefono    String     // Teléfono de WhatsApp
  latitud     Float?
  longitud    Float?
  
  usuarioId   Int        @unique // Dueño
  usuario     Usuario    @relation("DistribuidoraOwner", fields: [usuarioId], references: [id])
  
  empleados   Usuario[]  @relation("DistribuidoraEmpleados")
  
  productos   Producto[]
  pedidos     Pedido[]
}

// Tendero representa al cliente final que compra en la tienda de la Distribuidora
model Tendero {
  id            Int      @id @default(autoincrement())
  nombre_tienda String
  direccion     String
  telefono      String
  usuarioId     Int?     @unique
  usuario       Usuario? @relation(fields: [usuarioId], references: [id])
  pedidos       Pedido[]
}

model Producto {
  id               Int             @id @default(autoincrement())
  nombre           String
  precio           Float
  stock            Int
  categoria        String?
  imagenUrl        String?
  distribuidoraId  Int
  distribuidora    Distribuidora   @relation(fields: [distribuidoraId], references: [id])
  detallesPedido   DetallePedido[]
}

model Pedido {
  id              Int             @id @default(autoincrement())
  distribuidoraId Int
  tenderoId       Int?            // Opcional si permitimos checkout como invitado
  estado          String          @default("pendiente") // pendiente, preparado, en_ruta, entregado
  total           Float
  fecha           DateTime        @default(now())
  motivoReactivacion String?      // Para guardar el motivo cuando un pedido entregado es devuelto a pendiente
  
  distribuidora   Distribuidora   @relation(fields: [distribuidoraId], references: [id])
  tendero         Tendero?        @relation(fields: [tenderoId], references: [id])
  
  detalles        DetallePedido[]
  entrega         Entrega?
  
  // Datos del cliente si hace checkout sin estar registrado como Tendero formal
  nombreCliente   String?
  telefonoCliente String?
  direccionEnvio  String?
  latitud         Float?
  longitud        Float?
}

model DetallePedido {
  id         Int      @id @default(autoincrement())
  pedidoId   Int
  productoId Int
  cantidad   Int
  subtotal   Float
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Entrega {
  id          Int      @id @default(autoincrement())
  pedidoId    Int      @unique
  conductorId Int?
  estado      String
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  conductor   Usuario? @relation(fields: [conductorId], references: [id])
}
